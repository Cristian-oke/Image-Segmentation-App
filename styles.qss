
/* fereastra principala a aplicatiei */
QMainWindow {
    background-color: #1e222b;
}

QWidget {
    color: #e0e6ed;            /* culoarea implicita a textului */
    font-family: Segoe UI;
    font-size: 13px;           /* dimensiunea implicita a textului */
}


/* panou de grupare pentru sectiuni (Tools,Brush) */
QGroupBox {
    background-color: #252a34;
    border: 1px solid #323846;
    border-radius: 10px;
    margin-top: 16px;
    font-weight: bold;
    padding-top: 20px;
    padding-bottom: 12px;
}

/* titlul casetei de grupare */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* pozitionare fixa pe mijlocul laturii superioare */
    padding: 4px 14px;
    color: #4da6ff;
    background-color: #1e222b;
    border: 1px solid #3d4659;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}

/* stilul general pentru butoanele standard de actiune(Undo,Reset,Save) */
QPushButton {
    background-color: #2d3342;
    border: 1px solid #4da6ff;
    border-radius: 20px;
    color: #ffffff;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
}

/* starea la trecerea cursorului peste butoanele de actiune */
QPushButton:hover {
    background-color: #3b4356;
    border-color: #66b3ff;
}

/* starea la apasarea butonului */
QPushButton:pressed {
    background-color: #1f242e;
}

/* starile disabled pentru cele 3 butoane specifice de jos */
QPushButton#btn_export:disabled,
QPushButton#btn_reset:disabled,
QPushButton#btn_undo:disabled {
    background-color: #20242c;
    border: 1px solid #292e38;
    border-radius: 20px;
    color: #606773;
    font-size: 14px;
}

/* butoanele pentru Tools (Rectangle,Ellipse,Freehand) */
QPushButton#btn_tool_option {
    background-color: #1e222b;
    border: 1.5px solid #3d4659;

    /* forma asimetrica (colturi opuse rotunjite mai accentuat) */
    border-top-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    color: #e0e6ed;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    padding: 0px 8px;
}

/* starea la trecerea cursorului peste butoanele din Tools */
QPushButton#btn_tool_option:hover {
    background-color: #2a2f3d;
    border-color: #4da6ff;
    color: #ffffff;
}

/* starea activa (checked) pentru instrumentul curent */
QPushButton#btn_tool_option:checked {
    background-color: #2d384d;
    border: 2px solid #4da6ff;
    color: #4da6ff;
    font-weight: bold;
    font-size: 14px;
    /* inversarea curburii asimetrice la selectie */
    border-top-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

/* canvas */
QGraphicsView {
    border: 2px solid #323846;
    border-radius: 8px;
    background-color: #12151c;
}

/* butonul din centrul canvasului gol (empty state) */
QPushButton#btn_center_load {
    background-color: #2d3342;
    border: 1px solid #4da6ff;
    border-radius: 22px;
    padding: 0px;
}

QPushButton#btn_center_load:hover {
    background-color: #3b4356;
    border-color: #66b3ff;
}

QPushButton#btn_center_load:pressed {
    background-color: #1f242e;
}

/* stilul implicit pentru toate etichetele text */
QLabel {
    color: #a0aec0;
}

/* "No Image Loaded"*/
QLabel#lbl_no_image {
    color: #8c9bae;
    font-size: 12px;
    font-weight: 500;
}

/*"Size: x px" */
QLabel#lbl_brush {
    font-size: 15px;
    color: #989393;
    margin-bottom: 4px;
}

/*Slider*/
/* calea pe care gliseaza slider-ul pentru Brush Size */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #323846;
    border-radius: 3px;
}

/* cursor slider */
QSlider::handle:horizontal {
    background: #4da6ff;
    border: none;
    width: 16px;
    height: 16px;
    margin: -5px 0;            /* aliniere verticala pe linia de groove */
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #66b3ff;
}